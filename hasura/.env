HASURA_GRAPHQL_DATABASE_URL=postgres://postgres:password@hasura-postgres:5432/postgres
HASURA_GRAPHQL_ENABLE_CONSOLE="false"
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, websocket-log, query-log
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=public
HASURA_GRAPHQL_ADMIN_SECRET=password
HASURA_GRAPHQL_INFER_FUNCTION_PERMISSIONS="false"
# HASURA_GRAPHQL_METADATA_DIR='' # "/project/metadata"
# HASURA_GRAPHQL_MIGRATIONS_DIR='' # "/project/migrations"
HASURA_GRAPHQL_ENABLE_REMOTE_SCHEMA_PERMISSIONS="true"
HASURA_GRAPHQL_CORS_DOMAIN="http://localhost:8000, http://localhost:9695"
DEFANG_FN_ENDPOINT="http://fn:5001"
HASURA_GRAPHQL_EXPERIMENTAL_FEATURES="naming_convention"
HASURA_GRAPHQL_JWT_SECRET={"jwk_url":"http://heimdall:4457/.well-known/jwks"}
