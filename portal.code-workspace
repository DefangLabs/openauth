{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "web"
		},
		{
			"path": "kratos"
		},
		{
			"path": "hasura"
		},
		{
			"path": "fn"
		},
		{
			"path": "pulumi"
		},
		{
			"path": "heimdall"
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/CVS": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			".pnpm-store": true,
			"web": true,
			"kratos": true,
			"oathkeeper": true,
			"heimdall": true,
			"hasura": true,
			"fn": true,
			"pulumi": true,
		},
		"eslint.probe": [
			"javascript",
			"javascriptreact",
			"typescript",
			"typescriptreact",
			"html",
			"vue",
			"markdown",
			"json"
		],
		"sqltools.connections": [
			{
				"previewLimit": 50,
				"server": "localhost",
				"port": 54322,
				"driver": "PostgreSQL",
				"name": "Kratos",
				"database": "kratos",
				"username": "kratos",
				"password": "secret"
			}
		],
		"yaml.schemas": {
			"file:///workspace/chewy-global/lib/schemas/chewy-component-schema.json": "chewy-component.yml",
			"https://json.schemastore.org/prometheus.rules.json": "file:///Users/raphaeltitsworth-morin/dev/defang/portal/heimdall/config/rules/dev.rules.yaml"
		}
	},
	"tasks": {
		"version": "2.0.0",
		"inputs": [
			{
				"id": "dockerComposeCommand",
				"description": "docker-compose command",
				"type": "promptString",
			}
		],
		"tasks": [
			// install web dependencies
			{
				"label": "web: install",
				"type": "shell",
				"command": "npm i",
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": []
			},
			// install rest api dependencies
			{
				"label": "fn: install",
				"type": "shell",
				"command": "docker compose run --rm fn i",
				"options": {
					"cwd": "${workspaceFolder}/kratos"
				},
				"problemMatcher": []
			},
			{
				"label": "backend: run dev",
				"type": "shell",
				"command": "docker compose up",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"problemMatcher": [],
				"dependsOn": [
					"fn: install"
				]
			},
			{
				"label": "web: run dev",
				"type": "shell",
				"command": "npm run dev",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": [],
				"dependsOn": [
					"web: install"
				]
			},
			{
				"label": "web: graphql codegen",
				"type": "shell",
				"command": "npm run graphql-codegen",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": []
			},
			{
				"label": "hasura: console",
				"type": "shell",
				"command": "./console-dev",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"options": {
					"cwd": "${workspaceFolder}/hasura"
				},
				"problemMatcher": []
			},
		]
	},
	"extensions": {
		"recommendations": [
			"ms-azuretools.vscode-docker",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode"
		]
	}
}