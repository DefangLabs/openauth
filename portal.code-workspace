{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "web"
		},
		{
			"path": "hasura"
		},
		{
			"path": "api"
		},
		{
			"path": "auth"
		},
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/CVS": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			".pnpm-store": true,
			"web": true,
			"hasura": true,
			"api": true,
			"auth": true,
		},
		"eslint.probe": [
			"javascript",
			"javascriptreact",
			"typescript",
			"typescriptreact",
			"html",
			"vue",
			"markdown",
			"json"
		],
		"sqltools.connections": [
			{
				"previewLimit": 50,
				"server": "localhost",
				"port": 5432,
				"driver": "PostgreSQL",
				"name": "Local Dev",
				"database": "postgres",
				"username": "postgres",
				"password": "password"
			}
		],
	},
	"tasks": {
		"version": "2.0.0",
		"inputs": [
			{
				"id": "dockerComposeCommand",
				"description": "docker-compose command",
				"type": "promptString",
			}
		],
		"tasks": [
			// install web dependencies
			{
				"label": "web: install",
				"type": "shell",
				"command": "npm i",
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": []
			},// install web dependencies
			{
				"label": "web: generate gql",
				"type": "shell",
				"command": "npx graphql-codegen",
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": []
			},
			// install rest auth dependencies
			{
				"label": "api: install",
				"type": "shell",
				"command": "docker compose -f ./compose.dev.yaml --env-file .env.dev run --rm auth i",
				"problemMatcher": []
			},
			// install rest api dependencies
			{
				"label": "api: install",
				"type": "shell",
				"command": "docker compose -f ./compose.dev.yaml --env-file .env.dev run --rm api i",
				"problemMatcher": []
			},
			{
				"label": "backend: run dev",
				"type": "shell",
				"command": "docker compose -f ./compose.dev.yaml --env-file .env.dev up",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"problemMatcher": [],
				"dependsOrder": "parallel",
				"dependsOn": [
					"api: install"
				]
			},
			{
				"label": "web: run dev",
				"type": "shell",
				"command": "npm run dev",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": [],
				"dependsOn": [
					"web: install"
				]
			},
			{
				"label": "web: watch graphql",
				"type": "shell",
				"command": "./scripts/watch-graphql",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"options": {
					"cwd": "${workspaceFolder}/web"
				},
				"problemMatcher": []
			},
			{
				"label": "hasura: console",
				"type": "shell",
				"command": "./console-dev",
				"runOptions": {
					"runOn": "folderOpen"
				},
				"options": {
					"cwd": "${workspaceFolder}/hasura"
				},
				"problemMatcher": []
			},
		]
	},
	"extensions": {
		"recommendations": [
			"ms-azuretools.vscode-docker",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"type": "bun",
				"request": "attach",
				"name": "Attach to API",
				"url": "ws://localhost:6499"
			}
		],
		"compounds": []
	}
}